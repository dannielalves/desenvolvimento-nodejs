<h1>Bem vindo ao Servidor, {{user.name}}!</h1>

{{#if auth}} 
    <p>{{user.name}}, você está autenticado</p>
{{else}}
    <p>Você não está autenticado</p>
{{/if}}

<ol>
    {{#each itens}}
        <li>{{this}}</li>
    {{/each}}
</ol>

<hr>
<h1>Blog de tecnologia</h1>
{{#with post}}
        <h2>{{title}}</h2>
        <h3>Categoria: {{category}}</h3>
        <p>{{body}}</p>
        <p>Autor: {{author}}</p>
{{/with}}